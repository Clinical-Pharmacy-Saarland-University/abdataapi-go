meta {
  name: Compound Interaction
  type: http
  seq: 5
}

get {
  url: {{url}}/api/v1/interactions/compounds?compounds=ramipril,ciprofloxacin,chinidin,rifampicin,hydrochlorothiazid,sulfamethoxazole,trimethoprim
  body: none
  auth: inherit
}

params:query {
  compounds: ramipril,ciprofloxacin,chinidin,rifampicin,hydrochlorothiazid,sulfamethoxazole,trimethoprim
}

tests {
  test("returns success without text payload by default", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.status).to.equal("success");
    expect(Array.isArray(body.data)).to.equal(true);
    if (body.data.length > 0) {
      expect(body.data[0].text).to.equal(undefined);
    }
  });
}
