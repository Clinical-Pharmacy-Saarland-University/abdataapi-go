meta {
  name: PZN Interaction
  type: http
  seq: 3
}

get {
  url: {{url}}/api/v1/interactions/pzns?pzns=00639943,06995774
  body: none
  auth: inherit
}

params:query {
  pzns: 00639943,06995774
}

tests {
  test("returns success without text payload by default", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.status).to.equal("success");
    expect(Array.isArray(body.data)).to.equal(true);
    expect(body.data.length > 0).to.equal(true);
    expect(body.data[0].text).to.equal(undefined);
  });
}
