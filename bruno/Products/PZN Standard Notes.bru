meta {
  name: PZN Standard Notes
  type: http
  seq: 7
}

get {
  url: {{url}}/api/v1/product/standardnotes/pzns?pzns=00639943,06995774&lang=english
  body: none
  auth: inherit
}

params:query {
  pzns: 00639943,06995774
  lang: english
}

tests {
  test("returns standard notes grouped by PZN", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.status).to.equal("success");
    expect(Array.isArray(body.data)).to.equal(true);

    const product = body.data[0];
    expect(product.pzn).to.be.a("string");
    expect(product.product_name).to.be.a("string");
    expect(Array.isArray(product.standard_notes)).to.equal(true);

    if (product.standard_notes.length > 0) {
      const group = product.standard_notes[0];
      expect(group.category).to.be.a("string");
      expect(Array.isArray(group.notes)).to.equal(true);

      const note = group.notes[0];
      expect(note.patient_info).to.be.a("boolean");
      expect(note.text).to.be.a("string");
    }
  });
}
