# Integration test configuration (real ABDA database).
#
# Copy this file to  api/.env.integration  (which is git-ignored) and fill in the values,
# OR set the same variables in your shell. Shell variables take precedence.
#
# The integration tests run only with the build tag:  go test -tags=integration ./...
# (or `just test-integration`). They SKIP themselves unless ABDA_TEST_HOST is set, so a
# normal `go test ./...` never needs a database.
#
# Use a READ-ONLY database account: the ABDA queries are all SELECTs, so a read-only user
# means a test can never mutate data.

# Host and port reachable from your machine. Over an SSH tunnel this is the LOCAL end,
# e.g. 127.0.0.1:13306 — the port is part of the host (there is no separate port variable).
ABDA_TEST_HOST=127.0.0.1:XXXX

# Database credentials (secrets — never commit real values).
ABDA_TEST_USER=readonly_user
ABDA_TEST_PASSWORD=

# Database/schema name. Defaults to "abda" (matches cfg/default_config.yml) if omitted.
ABDA_TEST_DB=abda
